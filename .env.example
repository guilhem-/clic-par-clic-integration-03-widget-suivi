# Open WebUI : adresse et jeton d'un compte administrateur (Réglages › Compte › Clés API, ou jeton de session).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Studio 3D : adresse interne (vue depuis le serveur d'Open WebUI) et jeton du studio (le même que la connexion MCP du module 1).
STUDIO_URL=http://studio.studio3d.svc.cluster.local:8000
STUDIO_JETON=
# Groupe d'utilisateurs autorisés (créé au module 1).
GROUPE=Graphistes
